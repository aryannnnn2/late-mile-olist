	/// Item sales value of late orders. Not lost revenue.
	measure 'GMV Late (R$ M)' = CALCULATE([GMV (R$ M)], order_facts[is_late] = 1)
		formatString: """R$ ""0.00""M"""
		displayFolder: 3 Impact
		lineageTag: 8c47997d-4127-4ae8-b312-1b62a8f51a0b

	/// Item sales value of orders with a 1-star review. Not lost revenue.
	measure 'GMV 1-Star (R$ M)' = CALCULATE([GMV (R$ M)], order_facts[is_one_star] = 1)
		formatString: """R$ ""0.00""M"""
		displayFolder: 3 Impact
		lineageTag: 9397e053-ba6d-4b5b-8211-9d74c36c083d

	/// Share of all late orders explained by the worst N sellers (excess over expected).
	measure 'Cumulative Excess Share' = VAR r = MAX(seller_summary[excess_rank]) RETURN DIVIDE(CALCULATE(SUM(seller_summary[excess_late_orders]), FILTER(ALL(seller_summary), seller_summary[excess_rank] <= r)), [Late Orders])
		formatString: 0.0%
		displayFolder: 3 Impact
		lineageTag: 362ad334-412b-4851-a458-1caa5942ad01

	partition order_facts = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Intel\olist_data\order_facts.csv"),[Delimiter=",", Columns=22, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"order_id", type text}, {"customer_unique_id", type text}, {"customer_state", type text}, {"purchase_ts", type datetime}, {"carrier_ts", type datetime}, {"delivered_ts", type datetime}, {"estimated_ts", type datetime}, {"delay_days", Int64.Type}, {"seller_days", Int64.Type}, {"carrier_days", Int64.Type}, {"promised_days", Int64.Type}, {"total_days", Int64.Type}, {"item_value", type number}, {"freight_value", type number}, {"order_value", type number}, {"n_items", Int64.Type}, {"n_sellers", Int64.Type}, {"review_score", Int64.Type}, {"delay_bucket", type text}, {"is_late", Int64.Type}, {"is_one_star", Int64.Type}, {"came_back", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

