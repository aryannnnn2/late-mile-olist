table order_facts
	lineageTag: e6aedb1e-de6b-4f3f-8d4a-85e244892c7a

	measure Orders = COUNTROWS(order_facts)
		formatString: 0
		lineageTag: 0d05a6c2-f01f-489d-be16-87e83814ad8b

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Late %' = AVERAGE(order_facts[is_late])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8c305b99-261c-4c06-96e6-dbdec9bd0c38

	measure 'On-time %' = 1 - [Late %]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 144ff953-3cc9-4632-8d48-e75e110cd592

	measure 'Avg Review' = AVERAGE(order_facts[review_score])
		formatString: 0.00
		lineageTag: 9e4b4e15-9320-4177-885a-8a91bc2295fb

	/// Total item value in Brazilian reais (excludes freight).
	measure GMV = SUM(order_facts[item_value])
		formatString: """R$ ""#,0"
		lineageTag: 2a867412-5cc8-45ce-b60f-78c0d561d548

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Repeat %' = AVERAGE(order_facts[came_back])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bd8a1ed6-7a77-4b36-bc83-24938000f7ae

	/// Number of orders delivered after the estimated date.
	measure 'Late Orders' = SUM(order_facts[is_late])
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: d7f10efc-ce76-421e-a31b-cfb71f6a3fbd

	/// Share of orders with a 1-star review.
	measure '1-Star %' = AVERAGE(order_facts[is_one_star])
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: 99d3058f-0cb6-4db2-8d4c-2ec89c6454ae

	/// Item value in millions of Brazilian reais.
	measure 'GMV (R$ M)' = DIVIDE([GMV], 1000000)
		formatString: """R$ ""0.00""M"""
		displayFolder: 1 Core
		lineageTag: a7e3abf6-835b-47b1-a863-26bb6b44f56c

	/// Average review score for on-time orders.
	measure 'Avg Review On-time' = CALCULATE([Avg Review], order_facts[is_late] = 0)
		formatString: 0.00
		displayFolder: 2 Customer impact
		lineageTag: 02eaccae-bbe4-4334-9625-615ae622e95d

	/// Average review score for late orders.
	measure 'Avg Review Late' = CALCULATE([Avg Review], order_facts[is_late] = 1)
		formatString: 0.00
		displayFolder: 2 Customer impact
		lineageTag: a207bb69-7928-4d76-be60-b4c296b47341

	/// Review points lost when an order is late.
	measure 'Review Penalty' = [Avg Review On-time] - [Avg Review Late]
		formatString: 0.00
		displayFolder: 2 Customer impact
		lineageTag: c9443de2-3f59-41c7-949c-91315c831427

	measure '1-Star % On-time' = CALCULATE([1-Star %], order_facts[is_late] = 0)
		formatString: 0.0%
		displayFolder: 2 Customer impact
		lineageTag: cd4ac293-28f1-4754-b3bb-67b23d29eed4

	measure '1-Star % Late' = CALCULATE([1-Star %], order_facts[is_late] = 1)
		formatString: 0.0%
		displayFolder: 2 Customer impact
		lineageTag: d64ec387-6aeb-470d-90e4-8e4512845278

	measure '1-Star % 3+ Days Late' = CALCULATE([1-Star %], order_facts[delay_days] >= 3)
		formatString: 0.0%
		displayFolder: 2 Customer impact
		lineageTag: 89b7d7ba-5f7b-4837-aa73-8b36aa2f7d4b

	/// How many times more often late orders get a 1-star review.
	measure '1-Star Multiple (Late vs On-time)' = DIVIDE([1-Star % Late], [1-Star % On-time])
		formatString: 0.0"x"
		displayFolder: 2 Customer impact
		lineageTag: e6dd3e89-a2e5-4312-be91-94d39bbc53a4

	measure 'Repeat % Late' = CALCULATE([Repeat %], order_facts[is_late] = 1)
		formatString: 0.00%
		displayFolder: 2 Customer impact
		lineageTag: 091d1b2c-77c9-4f98-89ef-889752595c79

	measure 'Repeat % On-time' = CALCULATE([Repeat %], order_facts[is_late] = 0)
		formatString: 0.00%
		displayFolder: 2 Customer impact
		lineageTag: 0a9328cb-d7c6-4a6c-80a5-aafa8827d9f9

	measure 'Avg Carrier Days Late' = CALCULATE(AVERAGE(order_facts[carrier_days]), order_facts[is_late] = 1)
		formatString: 0.0
		displayFolder: 3 Delivery stages
		lineageTag: c856d5b4-3683-48b9-b26c-1c0f51b3ea52

	measure 'Avg Carrier Days On-time' = CALCULATE(AVERAGE(order_facts[carrier_days]), order_facts[is_late] = 0)
		formatString: 0.0
		displayFolder: 3 Delivery stages
		lineageTag: d55d4986-abf7-40f7-8f12-c583dcdbe147

	measure 'Avg Seller Days Late' = CALCULATE(AVERAGE(order_facts[seller_days]), order_facts[is_late] = 1)
		formatString: 0.0
		displayFolder: 3 Delivery stages
		lineageTag: a0cbbdfd-4687-4322-8ffe-92042da7a8b4

	measure 'Avg Seller Days On-time' = CALCULATE(AVERAGE(order_facts[seller_days]), order_facts[is_late] = 0)
		formatString: 0.0
		displayFolder: 3 Delivery stages
		lineageTag: df72bd93-c16a-4bfe-83c4-11e18085c4d7

	measure 'Extra Carrier Days' = [Avg Carrier Days Late] - [Avg Carrier Days On-time]
		formatString: 0.0
		displayFolder: 3 Delivery stages
		lineageTag: 46a8bd87-801f-4cd3-87ac-65344beda8b7

	measure 'Extra Seller Days' = [Avg Seller Days Late] - [Avg Seller Days On-time]
		formatString: 0.0
		displayFolder: 3 Delivery stages
		lineageTag: dc113e54-dec1-4972-8fb1-5f6b53c4e8f4

	/// Share of the extra transit time (late vs on-time orders) that happens at the carrier stage.
	measure 'Carrier Share of Extra Delay' = DIVIDE([Extra Carrier Days], [Extra Carrier Days] + [Extra Seller Days])
		formatString: 0%
		displayFolder: 3 Delivery stages
		lineageTag: 51249946-09fb-401d-a577-406c0c83c7f0

	/// Late rate minus the national late rate.
	measure 'Late % vs National' = [Late %] - CALCULATE([Late %], ALL(order_facts[customer_state]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Alerts
		lineageTag: 55cebb94-c77a-4737-90c9-07d9f3d8fa42

	/// Alert when the late rate is above 10%.
	measure 'Late % Alert' = IF([Late %] > 0.10, "Alert", "OK")
		displayFolder: 4 Alerts
		lineageTag: fc48bc14-b3b8-45a2-b73e-cc27a97dbc73

	/// Hex colour for conditional formatting: red above 10% late, blue otherwise.
	measure 'Late % Colour' = IF([Late %] > 0.10, "#E4572E", "#1F4E79")
		displayFolder: 4 Alerts
		lineageTag: 1d17ff63-0c39-401b-8a72-97c08c63709e

