{
  "name": "Olist Pro",
  "dataColors": [
    "#1F4E79",
    "#E4572E",
    "#76B7B2",
    "#F2A541",
    "#9AA5B1",
    "#59A14F",
    "#8E6C8A",
    "#4E79A7"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2733",
  "tableAccent": "#0F2A43",
  "good": "#2E9E6B",
  "neutral": "#F2A541",
  "bad": "#D64545",
  "maximum": "#1F4E79",
  "center": "#F2A541",
  "minimum": "#D9E2EC",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F2A43"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2733"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2733"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#52606D"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8EF"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1B2733"
              }
            },
            "alignment": "left"
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#0F2A43"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#52606D"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E3E8EF"
              }
            },
            "showAxisTitle": false,
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10
          }
        ],
        "lineStyles": [
          {
            "lineChartType": "linear",
            "strokeWidth": 3
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#52606D"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#52606D"
              }
            }
          }
        ]
      }
    },
    "stackedBarChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 10
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false,
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E3E8EF"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3E8EF"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 10,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F2A43"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 10,
            "fontColorPrimary": {
              "solid": {
                "color": "#1B2733"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1B2733"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F9FC"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#52606D"
              }
            }
          }
        ]
      }
    }
  }
}